{%- comment -%}
  Repères d'achat près du prix : dimensions du plateau, encombrement plié, poids, pièces, contenu du coffret.
  Source : tableau « Caractéristiques » de la description, ou métachamps custom.plateau, custom.dimensions_plie,
  custom.poids, custom.pieces, custom.contenu_coffret. Seules les infos présentes sont affichées.
{%- endcomment -%}
{%- liquid
  assign p = closest.product
  assign wanted = block.settings.labels | default: 'Plateau, Cases, Dimensions plié|Plié, Roi, Hauteur, Bois, Pièces, Poids' | split: ','
  assign has_any = false
  capture items
    for w in wanted
      assign parts = w | strip | split: '|'
      assign src = parts[0] | strip
      assign shown = parts[1] | default: src | strip
      assign mkey = src | handleize | replace: '-', '_'
      if mkey == 'dimensions_plie'
        assign mval = p.metafields.custom.dimensions_plie.value
      else
        assign mval = p.metafields.custom[mkey].value
      endif
      capture v
        if mval != blank
          echo mval
        else
          render 'ech-specs', product: p, label: src
        endif
      endcapture
      assign v = v | strip
      if v != blank
        assign has_any = true
        echo '<div><dt>' | append: shown | append: '</dt><dd>' | append: v | append: '</dd></div>'
      endif
    endfor
  endcapture
  capture plie
    render 'ech-specs', product: p, label: 'Dimensions plié'
  endcapture
  capture pieces
    render 'ech-specs', product: p, label: 'Pièces'
  endcapture
  assign plie = plie | strip
  capture contenu
    if p.metafields.custom.contenu_coffret != blank
      echo p.metafields.custom.contenu_coffret.value
    elsif plie != blank
      echo 'Le plateau pliant, qui sert de coffret, et les 32 pièces'
      assign pd = pieces | downcase
      if pd contains '2 dames'
        echo ', plus 2 dames supplémentaires'
      endif
      echo '.'
    endif
  endcapture
  assign contenu = contenu | strip
-%}
{%- if has_any -%}
  <div class="ech-specs" {{ block.shopify_attributes }}>
    <dl class="ech-specs__list">{{ items }}</dl>
    {%- if contenu != blank and block.settings.show_contents -%}
      <p class="ech-specs__box"><strong>Dans le coffret :</strong> {{ contenu }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Repères produit",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Lit le tableau Caractéristiques de la description, ou les métachamps custom.* du même nom (custom.contenu_coffret pour le contenu)." },
    { "type": "text", "id": "labels", "label": "Libellés à afficher", "default": "Plateau, Cases, Dimensions plié|Plié, Roi, Hauteur, Bois, Pièces, Poids", "info": "Libellés du tableau Caractéristiques, séparés par des virgules. « Libellé|Affiché » pour renommer. Seuls ceux présents s'affichent." },
    { "type": "checkbox", "id": "show_contents", "label": "Afficher « Dans le coffret »", "default": true }
  ],
  "presets": [{ "name": "Repères produit" }]
}
{% endschema %}
