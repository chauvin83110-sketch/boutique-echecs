{%- comment -%}
  Repères d'achat près du prix : dimensions du plateau, encombrement plié, poids, pièces, contenu du coffret.
  Source : tableau « Caractéristiques » de la description, ou métachamps custom.plateau, custom.dimensions_plie,
  custom.poids, custom.pieces, custom.contenu_coffret. Seules les infos présentes sont affichées.
{%- endcomment -%}
{%- liquid
  assign p = closest.product
  capture plateau
    if p.metafields.custom.plateau != blank
      echo p.metafields.custom.plateau.value
    else
      render 'ech-specs', product: p, label: 'Plateau'
    endif
  endcapture
  capture plie
    if p.metafields.custom.dimensions_plie != blank
      echo p.metafields.custom.dimensions_plie.value
    else
      render 'ech-specs', product: p, label: 'Dimensions plié'
    endif
  endcapture
  capture poids
    if p.metafields.custom.poids != blank
      echo p.metafields.custom.poids.value
    else
      render 'ech-specs', product: p, label: 'Poids'
    endif
  endcapture
  capture pieces
    if p.metafields.custom.pieces != blank
      echo p.metafields.custom.pieces.value
    else
      render 'ech-specs', product: p, label: 'Pièces'
    endif
  endcapture
  assign plateau = plateau | strip
  assign plie = plie | strip
  assign poids = poids | strip
  assign pieces = pieces | strip
  capture contenu
    if p.metafields.custom.contenu_coffret != blank
      echo p.metafields.custom.contenu_coffret.value
    elsif plateau != blank
      assign pl = plateau | downcase
      if pl contains 'pliant'
        echo 'Le plateau pliant, qui sert de coffret, et les 32 pièces'
      else
        echo 'Le plateau et les 32 pièces'
      endif
      assign pd = pieces | downcase
      if pd contains '2 dames'
        echo ', plus 2 dames supplémentaires'
      endif
      echo '.'
    endif
  endcapture
  assign contenu = contenu | strip
-%}
{%- if plateau != blank or plie != blank or poids != blank or pieces != blank -%}
  <div class="ech-specs" {{ block.shopify_attributes }}>
    <dl class="ech-specs__list">
      {%- if plateau != blank -%}<div><dt>Plateau</dt><dd>{{ plateau }}</dd></div>{%- endif -%}
      {%- if plie != blank -%}<div><dt>Plié</dt><dd>{{ plie }}</dd></div>{%- endif -%}
      {%- if poids != blank -%}<div><dt>Poids</dt><dd>{{ poids }}</dd></div>{%- endif -%}
      {%- if pieces != blank -%}<div><dt>Pièces</dt><dd>{{ pieces }}</dd></div>{%- endif -%}
    </dl>
    {%- if contenu != blank and block.settings.show_contents -%}
      <p class="ech-specs__box"><strong>Dans le coffret :</strong> {{ contenu }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Repères produit",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Lit le tableau Caractéristiques de la description (Plateau, Dimensions plié, Poids, Pièces) ou les métachamps custom.plateau, custom.dimensions_plie, custom.poids, custom.pieces, custom.contenu_coffret." },
    { "type": "checkbox", "id": "show_contents", "label": "Afficher « Dans le coffret »", "default": true }
  ],
  "presets": [{ "name": "Repères produit" }]
}
{% endschema %}
