{%- assign avis = avis | strip -%}
{%- if avis != blank -%}
<style>
  .ech-avis { max-width: 1180px; margin: 0 auto; padding: 56px 20px; border-top: 1px solid var(--ech-line); color: var(--ech-ink); }
  .ech-avis h2 { font-family: var(--ech-serif); font-weight: 500; font-size: clamp(1.8rem, 3.4vw, 2.6rem); line-height: 1.1; margin: .3rem 0 .6rem; }
  .ech-avis__src { font-size: .88rem; color: var(--ech-muted); max-width: 46em; margin: 0 0 1.8rem; line-height: 1.55; }
  .ech-avis__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 20px; }
  .ech-avis__item { background: var(--ech-sand); padding: 24px; }
  .ech-avis__item blockquote { margin: 0; padding: 0; border: 0; font-family: var(--ech-serif); font-size: 1.2rem; line-height: 1.45; font-style: normal; }
  .ech-avis__who { margin: 1rem 0 0; font-size: .85rem; color: var(--ech-muted); }
  .ech-avis__tag { display: inline-block; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--ech-green); margin-bottom: .6rem; }
  @media (min-width: 800px) { .ech-avis__list { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
</style>
<div class="ech-avis">
  <p class="ech-kicker">{{ section.settings.kicker | escape }}</p>
  <h2>{{ section.settings.title | escape }}</h2>
  <p class="ech-avis__src">{{ section.settings.source | escape }}</p>
  <ul class="ech-avis__list" role="list">{{ avis }}</ul>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Avis de l'atelier",
  "tag": "section",
  "class": "ech-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "Ils ont ce modèle chez eux" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Ce qu'en disent ceux qui l'ont en main" },
    { "type": "text", "id": "source", "label": "Mention d'origine (obligatoire)", "default": "Avis laissés par des acheteurs de ce modèle auprès de notre atelier partenaire, avant l'ouverture de Maison Roszada. Ce ne sont pas encore des avis de nos clients. Extraits traduits ; les coupes sont signalées par […]." }
  ],
  "presets": [{ "name": "Avis de l'atelier" }]
}
{% endschema %}
