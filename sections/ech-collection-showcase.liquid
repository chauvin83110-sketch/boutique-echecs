{%- liquid
  assign c = section.settings.collection
  assign limit = section.settings.limit
-%}
{%- if c.products_count > 0 or request.design_mode -%}
<div class="ech-showcase ech-wrap">
  <div class="ech-showcase__head">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="ech-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="ech-h2">{{ section.settings.title | default: c.title }}</h2>
    </div>
    {%- if c != blank -%}<a class="ech-link" href="{{ c.url }}">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
  {%- if section.settings.text != blank -%}<div class="ech-showcase__text">{{ section.settings.text }}</div>{%- endif -%}
  <ul class="ech-showcase__grid" role="list">
    {%- if c != blank and c.products_count > 0 -%}
      {%- for product in c.products limit: limit -%}
        <li>{% render 'ech-card', product: product %}</li>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <li class="ech-showcase__empty">{{ 'product-1' | placeholder_svg_tag: 'ech-card__img' }}<p>Choisissez une collection avec des produits actifs.</p></li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Accueil : collection",
  "tag": "section",
  "class": "ech-section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection mise en avant" },
    { "type": "text", "id": "kicker", "label": "Surtitre", "default": "La collection" },
    { "type": "text", "id": "title", "label": "Titre (vide = nom de la collection)" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "text", "id": "link_label", "label": "Lien", "default": "Tout voir" },
    { "type": "range", "id": "limit", "label": "Nombre de modèles", "min": 2, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Accueil : collection" }]
}
{% endschema %}
