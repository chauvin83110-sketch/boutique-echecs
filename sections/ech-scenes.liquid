{%- comment -%}
  Les pièces de la maison : une tuile photo par scène (collection), avec une légende.
  Les photos sont des décors d'ambiance, jamais présentées comme l'objet vendu.
{%- endcomment -%}
<div class="ech-scenes ech-wrap" id="ech-maison">
  <div class="ech-scenes__head">
    {%- if section.settings.kicker != blank -%}<p class="ech-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h2 class="ech-h2">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<div class="ech-scenes__text">{{ section.settings.text }}</div>{%- endif -%}
  </div>
  <ul class="ech-scenes__grid" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        if block.settings.image != blank
          assign src = block.settings.image | image_url: width: 1100
        elsif block.settings.asset != blank
          assign src = block.settings.asset | asset_url
        else
          assign src = blank
        endif
        assign href = block.settings.link | default: '/collections/all'
      -%}
      <li {{ block.shopify_attributes }}>
        <a class="ech-scene" href="{{ href }}">
          <span class="ech-scene__media">
            {%- if src != blank -%}
              <img src="{{ src }}" alt="{{ block.settings.alt | default: block.settings.title | escape }}" loading="lazy" style="object-position: {{ block.settings.position | default: '50% 50%' }};" width="800" height="1000">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'ech-scene__ph' }}
            {%- endif -%}
          </span>
          <span class="ech-scene__title">{{ block.settings.title }}</span>
          {%- if block.settings.caption != blank -%}<span class="ech-scene__cap">{{ block.settings.caption }}</span>{%- endif -%}
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Accueil : les scènes",
  "tag": "section",
  "class": "ech-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Surtitre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Chaque pièce a sa pièce" },
    { "type": "richtext", "id": "text", "label": "Texte" }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Scène",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo de la scène" },
        { "type": "text", "id": "asset", "label": "Ou fichier du thème (ex. ambiance-salon.jpg)" },
        { "type": "text", "id": "alt", "label": "Texte alternatif" },
        { "type": "text", "id": "position", "label": "Cadrage (ex. 50% 50%)" },
        { "type": "text", "id": "title", "label": "Nom de la scène", "default": "Le grand salon" },
        { "type": "text", "id": "caption", "label": "Légende" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Les scènes" }]
}
{% endschema %}
