{%- comment -%}
  Pied de page complet : réassurance, liens (boutique, service client, informations), newsletter,
  logos de paiement et mentions.
{%- endcomment -%}
<footer class="ech-footer">
  {%- assign perks = section.blocks | where: 'type', 'perk' -%}
  {%- if perks.size > 0 -%}
    <ul class="ech-perks ech-wrap" role="list">
      {%- for block in perks -%}
        <li class="ech-perk" {{ block.shopify_attributes }}>
          <span class="ech-perk__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M2 6h12v10H2zM14 9h4.5L22 12.5V16h-8z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="18" cy="17.5" r="1.8"/></svg>
              {%- when 'return' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5 4 9l4 4"/></svg>
              {%- when 'lock' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="4.5" y="10.5" width="15" height="10" rx="1.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
              {%- when 'gift' -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.3"><rect x="3.5" y="9" width="17" height="11.5"/><path d="M2.5 9h19v-3h-19zM12 6v14.5M12 6c-1.5-3-5-3-5 0M12 6c1.5-3 5-3 5 0"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M4 18v-5a8 8 0 0 1 16 0v5"/><rect x="3" y="14" width="4" height="6" rx="1"/><rect x="17" y="14" width="4" height="6" rx="1"/></svg>
            {%- endcase -%}
          </span>
          <span class="ech-perk__text"><strong>{{ block.settings.title }}</strong>{%- if block.settings.text != blank -%}<span>{{ block.settings.text }}</span>{%- endif -%}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="ech-footer__main ech-wrap">
    <div class="ech-footer__brand">
      <p class="ech-footer__name">{{ shop.name }}</p>
      {%- if section.settings.about != blank -%}<p class="ech-footer__about">{{ section.settings.about }}</p>{%- endif -%}
    </div>

    <nav class="ech-footer__col" aria-label="{{ section.settings.col1_title | escape }}">
      <p class="ech-footer__heading">{{ section.settings.col1_title }}</p>
      <ul role="list">
        {%- for link in section.settings.menu_shop.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <nav class="ech-footer__col" aria-label="{{ section.settings.col2_title | escape }}">
      <p class="ech-footer__heading">{{ section.settings.col2_title }}</p>
      <ul role="list">
        {%- if section.settings.menu_service != blank -%}
          {%- for link in section.settings.menu_service.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          {%- if pages['faq'].url != blank -%}<li><a href="{{ pages['faq'].url }}">FAQ</a></li>{%- endif -%}
          {%- if pages['contact'].url != blank -%}<li><a href="{{ pages['contact'].url }}">Nous contacter</a></li>{%- endif -%}
          {%- if shop.shipping_policy != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Livraison</a></li>{%- endif -%}
          {%- if shop.refund_policy != blank -%}<li><a href="{{ shop.refund_policy.url }}">Retours et remboursements</a></li>{%- endif -%}
          <li><a href="{{ routes.account_url }}">Mon compte</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <nav class="ech-footer__col" aria-label="{{ section.settings.col3_title | escape }}">
      <p class="ech-footer__heading">{{ section.settings.col3_title }}</p>
      <ul role="list">
        {%- if section.settings.menu_legal != blank -%}
          {%- for link in section.settings.menu_legal.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- else -%}
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </nav>

    {%- if section.settings.show_newsletter -%}
      <div class="ech-footer__news">
        <p class="ech-footer__heading">{{ section.settings.news_title }}</p>
        {%- if section.settings.news_text != blank -%}<p class="ech-footer__about">{{ section.settings.news_text }}</p>{%- endif -%}
        {%- form 'customer', id: 'ech-newsletter', class: 'ech-news' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="ech-news__ok" role="status">Merci, votre inscription est confirmée.</p>
          {%- else -%}
            <label for="ech-news-email" class="visually-hidden">Adresse e-mail</label>
            <div class="ech-news__row">
              <input id="ech-news-email" type="email" name="contact[email]" required autocomplete="email" placeholder="Votre adresse e-mail" value="{{ form.email }}">
              <button type="submit">S'inscrire</button>
            </div>
            {%- if form.errors -%}<p class="ech-news__err" role="alert">Adresse e-mail invalide ou déjà inscrite.</p>{%- endif -%}
            <p class="ech-news__legal">Désinscription en un clic à tout moment. Voir notre {% if shop.privacy_policy != blank %}<a href="{{ shop.privacy_policy.url }}">politique de confidentialité</a>{% else %}politique de confidentialité{% endif %}.</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>

  <div class="ech-footer__bottom ech-wrap">
    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="ech-payments" role="list" aria-label="Moyens de paiement acceptés">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'ech-payments__icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <p class="ech-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.copyright_text != blank %} · {{ section.settings.copyright_text }}{% endif %}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page boutique",
  "tag": "section",
  "class": "ech-section",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "textarea", "id": "about", "label": "Texte de présentation", "default": "Échiquiers en bois pliants, avec leurs pièces. Livraison offerte en France." },
    { "type": "text", "id": "col1_title", "label": "Colonne 1 : titre", "default": "La boutique" },
    { "type": "link_list", "id": "menu_shop", "label": "Colonne 1 : menu", "default": "main-menu" },
    { "type": "text", "id": "col2_title", "label": "Colonne 2 : titre", "default": "Service client" },
    { "type": "link_list", "id": "menu_service", "label": "Colonne 2 : menu", "info": "Vide = FAQ, contact, livraison, retours, compte." },
    { "type": "text", "id": "col3_title", "label": "Colonne 3 : titre", "default": "Informations" },
    { "type": "link_list", "id": "menu_legal", "label": "Colonne 3 : menu", "info": "Vide = politiques de la boutique (CGV, confidentialité…)." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Newsletter", "default": true },
    { "type": "text", "id": "news_title", "label": "Newsletter : titre", "default": "La lettre de l'échiquier" },
    { "type": "textarea", "id": "news_text", "label": "Newsletter : texte", "default": "Nouveaux modèles, conseils d'entretien et idées cadeaux. Un e-mail par mois, pas plus." },
    { "type": "text", "id": "copyright_text", "label": "Texte de bas de page", "default": "Paiement sécurisé" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Réassurance",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "truck", "options": [
          { "value": "truck", "label": "Livraison" },
          { "value": "return", "label": "Retour" },
          { "value": "lock", "label": "Paiement" },
          { "value": "gift", "label": "Cadeau" },
          { "value": "help", "label": "Service client" }
        ] },
        { "type": "text", "id": "title", "label": "Titre" },
        { "type": "text", "id": "text", "label": "Texte" }
      ]
    }
  ],
  "presets": [{ "name": "Pied de page boutique" }]
}
{% endschema %}
