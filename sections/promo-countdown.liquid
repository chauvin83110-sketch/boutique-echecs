{%- comment -%}
  Bandeau avec compte à rebours. RÈGLE : seulement pour une VRAIE échéance fixe (vraie promo, ou vraie
  date limite de commande pour Noël). Jamais un compte à rebours qui se relance. Il se masque tout seul à la date de fin.
{%- endcomment -%}
{%- liquid
  assign show = false
  if section.settings.enabled and section.settings.end_date != blank and section.settings.message != blank
    assign end_s = section.settings.end_date | append: ' +0100' | date: '%s' | plus: 0
    assign now_s = 'now' | date: '%s' | plus: 0
    if end_s > now_s
      assign show = true
    endif
  endif
-%}
{%- if show -%}
  <div class="ech-promo" data-ech-countdown data-end="{{ end_s }}">
    <p class="ech-promo__text">
      {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.message }}</a>{%- else -%}{{ section.settings.message }}{%- endif -%}
      <span class="ech-promo__timer" aria-live="off">
        {{ section.settings.timer_label | default: 'Fin dans' }} <span data-ech-countdown-text></span>
      </span>
    </p>
  </div>
{%- elsif request.design_mode -%}
  <div class="ech-promo ech-promo--off"><p class="ech-promo__text">Compte à rebours désactivé (réservé aux vraies promos avec date de fin).</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Compte à rebours promo",
  "tag": "section",
  "class": "ech-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "paragraph", "content": "À n'activer QUE pour une vraie échéance fixe (vraie promo ou vraie date limite de commande). Fausse urgence interdite (pratique commerciale trompeuse)." },
    { "type": "checkbox", "id": "enabled", "label": "Activer", "default": false },
    { "type": "text", "id": "message", "label": "Message", "default": "-15 % sur les coffrets cadeaux avec le code NOEL15" },
    { "type": "text", "id": "timer_label", "label": "Texte avant le minuteur", "default": "Fin dans" },
    { "type": "text", "id": "end_date", "label": "Date de fin (AAAA-MM-JJ HH:MM, heure de Paris)", "default": "2026-12-24 23:59" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [{ "name": "Compte à rebours promo" }]
}
{% endschema %}
