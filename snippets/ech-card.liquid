{%- doc -%}
  Carte produit maison : grande image, 2e vue au survol (ordinateur) ou au balayage (mobile),
  nom, finition, prix réel.
  @param {object} product
  @param {string} [sizes] - attribut sizes des images
  @param {boolean} [eager] - chargement prioritaire
{%- enddoc -%}
{%- liquid
  assign img1 = product.featured_media
  assign img2 = null
  for m in product.media
    if m.id != img1.id and m.media_type == 'image'
      assign img2 = m
      break
    endif
  endfor
  assign sz = sizes | default: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw'
  assign load = 'lazy'
  if eager
    assign load = 'eager'
  endif
  capture nm
    render 'ech-product-name', product: product, part: 'name'
  endcapture
  capture fin
    render 'ech-product-name', product: product, part: 'finish'
  endcapture
  assign fin = fin | strip
-%}
<article class="ech-card">
  <a class="ech-card__media{% if img2 %} has-alt{% endif %}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    <span class="ech-card__track">
      {%- if img1 -%}
        {{ img1 | image_url: width: 1200 | image_tag: loading: load, sizes: sz, widths: '400, 600, 800, 1000, 1200', class: 'ech-card__img', alt: img1.alt | default: product.title }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'ech-card__img' }}
      {%- endif -%}
      {%- if img2 -%}
        {{ img2 | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: sz, widths: '400, 600, 800, 1000, 1200', class: 'ech-card__img ech-card__img--alt', alt: img2.alt | default: product.title }}
      {%- endif -%}
    </span>
    {%- if img2 -%}<span class="ech-card__dots" aria-hidden="true"><i></i><i></i></span>{%- endif -%}
  </a>
  <div class="ech-card__info">
    <h3 class="ech-card__name"><a href="{{ product.url }}">{{ nm | strip }}</a></h3>
    {%- if fin != blank -%}<p class="ech-card__finish">{{ fin }}</p>{%- endif -%}
    <p class="ech-card__price">
      {%- if product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
      {%- if product.price_varies -%}À partir de {% endif -%}{{ product.price | money }}
      {%- unless product.available -%} <span class="ech-card__soldout">Épuisé</span>{%- endunless -%}
    </p>
  </div>
</article>
