{%- doc -%}
  Grande bannière photo numérotée insérée dans la grille produits (style magazine).
  @param {object} section - Section main-collection
  @param {number} n - Numéro de la bannière (1 à 3)
{%- enddoc -%}
{%- liquid
  assign prefix = 'banner_' | append: n | append: '_'
  assign k_image = prefix | append: 'image'
  assign k_label = prefix | append: 'label'
  assign k_title = prefix | append: 'title'
  assign k_text = prefix | append: 'text'
  assign k_link = prefix | append: 'link'
  assign k_button = prefix | append: 'button'
  assign b_image = section.settings[k_image]
  assign b_link = section.settings[k_link]
-%}
<li class="ech-banner{% if b_image == blank %} ech-banner--plain{% endif %}" aria-label="{{ section.settings[k_title] | escape }}">
  {%- if b_link != blank -%}<a class="ech-banner__inner" href="{{ b_link }}">{%- else -%}<div class="ech-banner__inner">{%- endif -%}
    {%- if b_image != blank -%}
      {{ b_image | image_url: width: 2000 | image_tag: class: 'ech-banner__img', loading: 'lazy', sizes: '(min-width: 750px) 90vw, 100vw', widths: '600, 900, 1200, 1600, 2000', alt: section.settings[k_title] }}
    {%- endif -%}
    <div class="ech-banner__content">
      {%- if section.settings[k_label] != blank -%}
        <span class="ech-banner__num">[{{ section.settings[k_label] }}]</span>
      {%- endif -%}
      <h2 class="ech-banner__title">{{ section.settings[k_title] }}</h2>
      {%- if section.settings[k_text] != blank -%}
        <p class="ech-banner__text">{{ section.settings[k_text] }}</p>
      {%- endif -%}
      {%- if b_link != blank and section.settings[k_button] != blank -%}
        <span class="ech-banner__cta">{{ section.settings[k_button] }} <span aria-hidden="true">→</span></span>
      {%- endif -%}
    </div>
  {%- if b_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
</li>
